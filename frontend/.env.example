# Copy to .env.local for local development. Only NEXT_PUBLIC_* values are
# exposed to the browser, so NEVER put secrets (service-role keys, LLM keys) here.

# "mock" runs entirely in the browser with synthetic data (default).
# "real" calls the FastAPI backend.
NEXT_PUBLIC_API_MODE=mock

# Backend ORIGIN, without /api/v1 (the client appends it).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (public anon key only). Enables /login in real mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development ONLY: sent as X-Dev-User-ID. The backend honours it only
# when APP_ENV=development and DEV_AUTH_BYPASS=true. Leave empty in production.
NEXT_PUBLIC_DEV_USER_ID=
