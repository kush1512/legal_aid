# Runtime
APP_ENV=development
APP_NAME=Legal Aid API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Supabase. Keep service-role credentials on backend only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
MOCK_STORAGE=true
DEV_AUTH_BYPASS=true

# LLM: mock works without keys; preferred prototype: Gemini, alternative Groq.
LLM_PROVIDER=mock
LLM_MODEL=mock-legal-aid-v1
CASE_EXTRACTION_MODEL=
LEGAL_EXPLANATION_MODEL=
DOCUMENT_DRAFT_MODEL=
GEMINI_API_KEY=
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=35
LLM_MAX_OUTPUT_TOKENS=1800
LLM_MAX_RETRIES=2
LLM_FALLBACK_ENABLED=true
ALLOW_EXTERNAL_LLM_FOR_SENSITIVE=false
# A sensitive case requires explicit user consent AND this opt-in to permit external processing.
# Keep false for free-tier credentials.

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu

# Speech. Groq Whisper is only used when a key is configured and privacy allows it.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
MAX_AUDIO_BYTES=20971520
MAX_UPLOAD_BYTES=15728640

# Abuse and cost controls (per-process; use a shared store for multi-instance production).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_CACHE_TTL_SECONDS=30
MAX_REQUEST_CHARS=12000
