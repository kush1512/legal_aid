# Runtime
APP_ENV=development
APP_NAME=Legal Aid API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Supabase. Keep service-role credentials on backend only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
MOCK_STORAGE=true
DEV_AUTH_BYPASS=true # Local development only; set false in production

# LLM provider. The safe default is mock; setting GROQ_API_KEY alone does not select Groq.
# To enable live Groq responses for eligible non-sensitive cases, set:
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=<backend-only secret>
LLM_PROVIDER=mock
LLM_MODEL=mock-legal-aid-v1
CASE_EXTRACTION_MODEL=
LEGAL_EXPLANATION_MODEL=
DOCUMENT_DRAFT_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=
LLM_TIMEOUT_SECONDS=35
LLM_MAX_OUTPUT_TOKENS=1800
LLM_MAX_RETRIES=2
LLM_FALLBACK_ENABLED=true

# External AI is allowed only for non-sensitive cases with explicit per-request consent.
# Keep sensitive categories, personal identifiers and private conversations blocked.
ALLOW_EXTERNAL_LLM_FOR_NON_SENSITIVE=true
ALLOW_EXTERNAL_LLM_FOR_SYNTHETIC=false
SYNTHETIC_DEMO_USER_IDS=
ADMIN_USER_IDS=
ALLOW_EXTERNAL_LLM_FOR_SENSITIVE=false

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu

# Speech transcription uses Groq Whisper and has a separate consent/allowlist gate.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
MAX_AUDIO_BYTES=20971520
MAX_UPLOAD_BYTES=15728640

# Abuse and cost controls (per-process; use a shared store for multi-instance production).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_CACHE_TTL_SECONDS=30
MAX_REQUEST_CHARS=12000
